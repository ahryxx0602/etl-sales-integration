{
  "name": "etl-rmq",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "etl:all": "concurrently \"node src/workers/validateWorker.js\" \"node src/workers/transformWorker.js\" \"node src/workers/loadWorker.js\"",
    "setup": "node src/setup.js",
    "w:validate": "node src/workers/validateWorker.js",
    "w:transform": "node src/workers/transformWorker.js",
    "w:load": "node src/workers/loadWorker.js",
    "ingest:csv": "node src/producers/csv_ingest.js",
    "lint": "eslint .",
    "test": "echo 'No test specified' && exit 0",
    "start": "node src/setup.js && node src/producers/csv_ingest.js",
    "pm2:start": "pm2 start src/workers/validateWorker.js --name etl-validate && pm2 start src/workers/transformWorker.js --name etl-transform && pm2 start src/workers/loadWorker.js --name etl-load",
    "pm2:restart": "pm2 restart etl-validate || true && pm2 restart etl-transform || true && pm2 restart etl-load || true",
    "pm2:stop": "pm2 delete etl-validate etl-transform etl-load || true",
    "pm2:save": "pm2 save",
    "start:transform": "node src/workers/transformWorker.js",
    "send:test": "node src/send_transform_test.js",
    "consume:clean": "node src/consume_clean_test.js",
    "setup:queues": "node -e \"import('./src/rabbit.js').then(m=>m.getRabbit().then(({_conn,ch})=>{console.log('ok');ch.close();_conn.close()}))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "amqplib": "^0.10.9",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "mysql2": "^3.15.3",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.1.2",
    "pm2": "^5.4.2"
  }
}
