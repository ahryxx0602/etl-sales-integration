<!-- Stats Cards -->
<section class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <h3>Cửa hàng</h3>
            <p class="stat-value" x-text="stats.stores || 0">-</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Khách hàng</h3>
            <p class="stat-value" x-text="stats.customers || 0">-</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Sản phẩm</h3>
            <p class="stat-value" x-text="stats.products || 0">-</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Đơn hàng</h3>
            <p class="stat-value" x-text="stats.orders || 0">-</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Chi tiết đơn</h3>
            <p class="stat-value" x-text="stats.orderItems || 0">-</p>
        </div>
    </div>
</section>

